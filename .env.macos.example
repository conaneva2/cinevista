# Source this in the shell after installing the actual tools; not a package installer.
# No sudo, no system security changes. Actual macOS27 execution still needs testing.
export JAVA_HOME="$(brew --prefix openjdk@17)/libexec/openjdk.jdk/Contents/Home"
export ANDROID_SDK_ROOT="$HOME/Library/Android/sdk"
export ANDROID_HOME="$ANDROID_SDK_ROOT"
export ANDROID_SDK="$ANDROID_SDK_ROOT"  # Recipe Lab's variable
export CINEVISTA_ANDROID10_JAR="$ANDROID_SDK_ROOT/platforms/android-10/android.jar"
export PATH="$JAVA_HOME/bin:$ANDROID_SDK_ROOT/cmdline-tools/latest/bin:$PATH"
# Reproducing Recipe Lab ONLY: additional native backend / r16b, not needed by our Java probe.
# export ANDROID_NDK="/your/verified/android-ndk-r16b"
# export PLATFORM_JAR="$ANDROID_SDK_ROOT/platforms/android-28/android.jar"
