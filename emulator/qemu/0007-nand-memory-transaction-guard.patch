+/* A host-model transaction failure must not become a clean completion.
+ * Sony bus-fault status/IRQ semantics are unknown: fail closed instead of
+ * synthesizing them. Earlier transfers may already have taken effect.
+ */
+static void nand_dma_memory(hwaddr addr, void *buffer, hwaddr length,
+                            bool is_write, const char *phase)
+{
+    MemTxResult result = address_space_rw(&address_space_memory, addr,
+                                          MEMTXATTRS_UNSPECIFIED, buffer,
+                                          length, is_write);
+    if (result != MEMTX_OK) {
+        hw_error("bionz_nand: %s memory transaction failed (0x%x)\n",
+                 phase, result);
+    }
+}
+
