+/* Experimental persistent backend; completion follows successful flush. */
+static void nand_program(NandState *s, uint64_t offset, uint32_t length,
+                         uint32_t guest_buffer)
+{
+    uint8_t *old = g_malloc(length), *data = g_malloc(length);
+    uint32_t i;
+    if (!s->blk || blk_is_read_only(s->blk) ||
+        blk_pread(s->blk, offset, old, length) < 0) {
+        hw_error("nand_program: missing/read-only/unreadable backend\n");
+    }
+    cpu_physical_memory_read(guest_buffer, data, length);
+    for (i = 0; i < length; i++) {
+        data[i] &= old[i]; /* NAND programming clears bits; erase restores ones. */
+    }
+    if (blk_pwrite(s->blk, offset, data, length, 0) < 0) {
+        hw_error("nand_program: write failed\n");
+    }
+    g_free(old);
+    g_free(data);
+}
+
+static void nand_erase(NandState *s, uint32_t page)
+{
+    uint32_t pages = s->reg_pages_per_block;
+    uint64_t offset = (uint64_t)page * NAND_PAGE_SIZE;
+    uint64_t len = (uint64_t)pages * NAND_PAGE_SIZE;
+    uint8_t *ff;
+    if (!s->blk || blk_is_read_only(s->blk) || !pages || pages > 4096 ||
+        page % pages || offset + len > s->size) {
+        hw_error("nand_erase: invalid geometry/range/backend\n");
+    }
+    ff = g_malloc(len);
+    memset(ff, 0xff, len);
+    if (blk_pwrite(s->blk, offset, ff, len, 0) < 0 ||
+        blk_pwrite(s->blk, s->size + (uint64_t)page * NAND_SPARE_SIZE,
+                   ff, pages * NAND_SPARE_SIZE, 0) < 0 ||
+        blk_flush(s->blk) < 0) {
+        hw_error("nand_erase: persistence failed\n");
+    }
+    g_free(ff);
+}
