+/* The legacy backend stores logical metadata, not raw ECC/OOB codewords.
+ * Opt-in evidence mode must never turn an unsupported ECC transfer into a
+ * clean descriptor/status/IRQ. Stop before touching buffers or the medium.
+ */
+static void nand_require_supported_ecc(NandState *s)
+{
+    if (s->strict_ecc && (s->reg_ecc_enable & 1)) {
+        hw_error("bionz_nand: ECC execution is not modeled\n");
+    }
+}
